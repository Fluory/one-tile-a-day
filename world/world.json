  "days": [
    {"day":0,"date":"2026-09-28","action":"genesis","x":31,"y":32,"title":"A sandbank in the open sea","lore":"Nothing but water – and in the middle of it, a small sandbank. Tomorrow, the island begins.","source":"genesis"},
    {"day":1,"date":"2026-09-29","action":"land","x":33,"y":31,"title":"The sandbank stretches north-east","lore":"At low tide a new strip of sand rises off the north-east coast, and the sandbank is a little less alone.","source":"claude","terrain":{"from":"water","to":"sand"}},
    {"day":2,"date":"2026-09-30","action":"meadow","x":31,"y":32,"title":"The first grass on the western dunes","lore":"Between the dunes, sheltered from the wind, a first patch of green grass takes root in the sand.","source":"claude","terrain":{"from":"sand","to":"grass"}},
    {"day":3,"date":"2026-10-01","action":"tree","x":31,"y":32,"title":"A sapling in the young meadow","lore":"In the middle of the new grass a single sapling unfolds its first leaves, already leaning a little away from the sea wind.","source":"claude","element":"e1"},
    {"day":4,"date":"2026-10-02","action":"animal","x":33,"y":31,"title":"A gull lands on the north-east shore","lore":"A grey gull drifts in on the morning wind, folds its wings on the new sand and decides, for now, to stay.","source":"claude","element":"e2"},
    {"day":5,"date":"2026-10-03","action":"land","x":33,"y":33,"title":"New sand off the south-east coast","lore":"Overnight the tide leaves a fresh crescent of sand in the south-east, and the gull walks its whole length before breakfast.","source":"claude","terrain":{"from":"water","to":"sand"}},
    {"day":6,"date":"2026-10-04","action":"meadow","x":32,"y":32,"title":"The meadow crosses to the eastern dunes","lore":"The grass creeps east overnight, and now the sapling stands at the edge of a meadow two tiles wide.","source":"claude","terrain":{"from":"sand","to":"grass"}},
    {"day":7,"date":"2026-10-05","action":"land","x":30,"y":33,"title":"A sandy point in the south-west","lore":"In the south-west a low sandy point slips out of the water, and the waves begin to curl around it in a new way.","source":"claude","terrain":{"from":"water","to":"sand"}},
    {"day":8,"date":"2026-10-06","action":"land","x":30,"y":31,"title":"A sandbar in the north-west","lore":"A pale sandbar surfaces off the north-west coast, still wet and shining, and the gull is the first to leave footprints on it.","source":"claude","terrain":{"from":"water","to":"sand"}},
    {"day":9,"date":"2026-10-07","action":"rock","x":30,"y":33,"title":"The first stone on the south-west point","lore":"On the south-west point a dark stone breaks through the sand, and the waves now have something to talk to.","source":"claude","terrain":{"from":"sand","to":"rock"}},
    {"day":10,"date":"2026-10-08","action":"land","x":31,"y":30,"title":"The north shore reaches out","lore":"On the north side a broad tongue of sand rises at dawn, and from its tip the whole small island can be seen at once.","source":"claude","terrain":{"from":"water","to":"sand"}}
